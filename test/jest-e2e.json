{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^@apk_infra/(.*)$": "<rootDir>/../src/core/infra/$1",
    "^@apk_core/(.*)$": "<rootDir>/../src/core/$1",
    "^@apk_modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@apk_shared/(.*)$": "<rootDir>/../src/shared/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
