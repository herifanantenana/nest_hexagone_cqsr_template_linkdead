{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{
				"include": "core/config/files/*.yaml",
				"outDir": "dist/src"
			},
			{
				"include": "core/infra/mailer/adapters/templates/**/*.hbs",
				"outDir": "dist/src"
			}
		],
		"watchAssets": true
	}
}
