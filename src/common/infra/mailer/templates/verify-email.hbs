{{! Verify Email Template }}
{{> header title="Vérification de votre adresse email" }}

<div style="padding: 40px 32px;">
	<h2 style="color: #18181b; margin: 0 0 16px 0; font-size: 20px; font-weight: 600;">Bienvenue {{username}} !</h2>

	<p style="color: #3f3f46; line-height: 1.6; margin: 0 0 24px 0;">
		Merci de vous être inscrit. Pour commencer à utiliser votre compte, veuillez vérifier votre adresse email en cliquant sur le bouton ci-dessous.
	</p>

	<div style="text-align: center; margin: 32px 0;">
		<a href="{{verifyUrl}}" style="display: inline-block; background: #16a34a; color: #ffffff; padding: 14px 40px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 15px;">Vérifier mon email</a>
	</div>

	<p style="color: #71717a; font-size: 13px; line-height: 1.5; margin: 24px 0 0 0;">
		Si vous n'êtes pas à l'origine de cette inscription, vous pouvez ignorer cet email.
	</p>
</div>

{{> footer }}