	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "cross-env NODE_ENV=development APP_RUNTIME=dev nest start",
		"start:dev": "cross-env NODE_ENV=development APP_RUNTIME=dev nest start --watch",
		"start:debug": "cross-env NODE_ENV=development APP_RUNTIME=dev nest start --debug --watch",
		"start:docker": "cross-env NODE_ENV=production APP_RUNTIME=docker node dist/src/main.js",
		"start:prod": "cross-env NODE_ENV=production APP_RUNTIME=prod node dist/src/main.js",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"db:push": "cross-env APP_RUNTIME=dev drizzle-kit push",
		"db:pull": "cross-env APP_RUNTIME=dev drizzle-kit pull",
		"db:generate": "cross-env APP_RUNTIME=dev drizzle-kit generate",
