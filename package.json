		"db:migrate:base": "cross-env APP_RUNTIME=dev drizzle-kit migrate",
		"db:post-migrate": "cross-env APP_RUNTIME=dev ts-node ./src/core/infra/database/seed/post-migrate.ts",
		"db:studio": "cross-env APP_RUNTIME=dev drizzle-kit studio",
		"db:clean": "cross-env APP_RUNTIME=dev ts-node ./src/core/infra/database/seed/clean.ts",
		"db:reset": "cross-env APP_RUNTIME=dev ts-node ./src/core/infra/database/seed/reset.ts",
		"db:push:docker": "cross-env APP_RUNTIME=docker drizzle-kit push",
		"db:pull:docker": "cross-env APP_RUNTIME=docker drizzle-kit pull",
		"db:generate:docker": "cross-env APP_RUNTIME=docker drizzle-kit generate",
		"db:migrate:docker": "cross-env APP_RUNTIME=docker drizzle-kit migrate && pnpm db:post-migrate:docker",
		"db:migrate:base:docker": "cross-env APP_RUNTIME=docker drizzle-kit migrate",
		"db:post-migrate:docker": "cross-env APP_RUNTIME=docker ts-node ./src/core/infra/database/seed/post-migrate.ts",
		"db:studio:docker": "cross-env APP_RUNTIME=docker drizzle-kit studio",
		"db:clean:docker": "cross-env APP_RUNTIME=docker ts-node ./src/core/infra/database/seed/clean.ts",
		"db:reset:docker": "cross-env APP_RUNTIME=docker ts-node ./src/core/infra/database/seed/reset.ts",
		"db:push:prod": "cross-env APP_RUNTIME=prod drizzle-kit push",
		"db:pull:prod": "cross-env APP_RUNTIME=prod drizzle-kit pull",
		"db:generate:prod": "cross-env APP_RUNTIME=prod drizzle-kit generate",
		"db:migrate:prod": "cross-env APP_RUNTIME=prod drizzle-kit migrate && pnpm db:post-migrate:prod",
		"db:migrate:base:prod": "cross-env APP_RUNTIME=prod drizzle-kit migrate",
		"db:post-migrate:prod": "cross-env APP_RUNTIME=prod ts-node ./src/core/infra/database/seed/post-migrate.ts",
		"db:studio:prod": "cross-env APP_RUNTIME=prod drizzle-kit studio",
		"db:clean:prod": "cross-env APP_RUNTIME=prod ts-node ./src/core/infra/database/seed/clean.ts",
		"db:reset:prod": "cross-env APP_RUNTIME=prod ts-node ./src/core/infra/database/seed/reset.ts"
